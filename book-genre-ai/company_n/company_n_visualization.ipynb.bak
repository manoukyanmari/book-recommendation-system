    "# Detailed cluster analysis and interpretation\n",
    "try:\n",
    "    if 'optimal_k' not in locals() or 'cluster_info' not in locals():\n",
    "        print(\"⚠️ K-Means clustering results not available.\")\n",
    "        print(\"Please run the K-Means Elbow Analysis cell (cell 41) first to compute optimal_k and cluster_info.\")\n",
