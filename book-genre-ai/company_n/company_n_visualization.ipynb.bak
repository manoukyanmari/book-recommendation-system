   ],
   "source": [
    "# Translation Helper for POS Tagging\n",
    "# Translates Armenian titles to English before grammatical analysis\n",
    "# This ensures NLTK POS tagger (trained on English) can accurately extract emotional/semantic patterns\n",
    "\n",
    "try:\n",
    "    from google.cloud import translate_v2\n",
    "    TRANSLATOR = translate_v2.Client()\n",
    "    \n",
    "    def translate_title_to_english(title):\n",
    "        \"\"\"Translate Armenian title to English using Google Cloud Translate\"\"\"\n",
    "        if pd.isna(title) or title.strip() == '':\n",
    "            return title\n",
    "        try:\n",
    "            result = TRANSLATOR.translate_text(title, target_language='en')\n",
    "            return result['translatedText']\n",
    "        except:\n",
    "            return title  # Return original if translation fails\n",
    "    \n",
    "    print(\"✅ Google Cloud Translator initialized\")\n",
    "    TRANSLATION_METHOD = \"Google Cloud\"\n",
    "    \n",
    "except Exception as e:\n",
    "    # Fallback: Use googletrans library (free alternative)\n",
    "    try:\n",
    "        from googletrans import Translator\n",
    "        TRANSLATOR = Translator()\n",
    "        \n",
    "        def translate_title_to_english(title):\n",
    "            \"\"\"Translate Armenian title to English using googletrans\"\"\"\n",
    "            if pd.isna(title) or title.strip() == '':\n",
    "                return title\n",
    "            try:\n",
    "                result = TRANSLATOR.translate(title, src_lang='hy', dest_lang='en')\n",
    "                return result.text\n",
    "            except:\n",
    "                return title\n",
    "        \n",
    "        print(\"✅ googletrans Translator initialized\")\n",
    "        TRANSLATION_METHOD = \"googletrans (free)\"\n",
    "        \n",
    "    except ImportError:\n",
    "        print(\"⚠️ Translation libraries not available. Installing googletrans...\")\n",
    "        import subprocess\n",
    "        subprocess.check_call(['pip', 'install', 'googletrans==4.0.0rc1', '-q'])\n",
    "        from googletrans import Translator\n",
    "        TRANSLATOR = Translator()\n",
    "        \n",
    "        def translate_title_to_english(title):\n",
    "            if pd.isna(title) or title.strip() == '':\n",
    "                return title\n",
    "            try:\n",
    "                result = TRANSLATOR.translate(title, src_lang='hy', dest_lang='en')\n",
    "                return result.text\n",
    "            except:\n",
    "                return title\n",
    "        \n",
    "        print(\"✅ googletrans installed and initialized\")\n",
    "        TRANSLATION_METHOD = \"googletrans (free)\"\n",
    "\n",
    "# Create English translation column for all titles\n",
    "print(f\"\\n🌐 Translating Armenian titles to English using {TRANSLATION_METHOD}...\")\n",
    "df['title_english'] = df['Title'].apply(translate_title_to_english)\n",
    "print(f\"✅ Translation complete: {df['title_english'].notna().sum()} titles translated\")"
   ]
  },
