    "\n",
    "positive_titles = df[df['sentiment_category'] == 'Positive']\n",
    "negative_titles = df[df['sentiment_category'] == 'Negative']\n",
    "neutral_titles = df[df['sentiment_category'] == 'Neutral']\n",
