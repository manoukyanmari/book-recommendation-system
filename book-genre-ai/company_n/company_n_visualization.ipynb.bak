    "# Data Preparation: Distribution Analysis Variables\n",
    "print(\"📊 PREPARING DISTRIBUTION ANALYSIS DATA...\")\n",
    "\n",
    "# Sort by transaction volume and calculate percentiles\n",
    "df_sorted = df.sort_values('Number', ascending=False).copy()\n",
    "df_sorted['cumsum_volume'] = df_sorted['Number'].cumsum()\n",
    "df_sorted['cumsum_pct'] = (df_sorted['cumsum_volume'] / df_sorted['Number'].sum()) * 100\n",
    "df_sorted['title_pct'] = (np.arange(1, len(df_sorted) + 1) / len(df_sorted)) * 100\n",
    "\n",
    "# Key metrics\n",
    "total_volume = df['Number'].sum()\n",
    "total_titles = len(df)\n",
    "\n",
    "# Calculate 80/20 rule thresholds\n",
    "threshold_80_pct = 0.8 * total_volume\n",
    "threshold_20_pct = 0.2 * total_volume\n",
    "titles_for_80_pct = df_sorted[df_sorted['cumsum_volume'] <= threshold_80_pct]\n",
    "titles_needed_80 = len(titles_for_80_pct) + 1\n",
    "pct_titles_for_80 = (titles_needed_80 / total_titles) * 100\n",
    "titles_for_20_pct = df_sorted[df_sorted['cumsum_volume'] <= threshold_20_pct]\n",
    "\n",
    "# Decile analysis (divide into 10 equal groups by volume)\n",
    "decile_size = len(df) // 10\n",
    "\n",
    "# Top percentile analysis\n",
    "top_1_pct_idx = int(len(df_sorted) * 0.01)\n",
    "top_1_pct = df_sorted.iloc[:top_1_pct_idx]\n",
    "top_1_pct_threshold = df_sorted['Number'].iloc[top_1_pct_idx] if top_1_pct_idx > 0 else df_sorted['Number'].min()\n",
    "\n",
    "# Outlier detection using z-score\n",
    "from scipy.stats import zscore\n",
    "df['z_score'] = np.abs(zscore(df['Number']))\n",
    "z_outliers = df[df['z_score'] > 2.5]\n",
    "\n",
    "print(f\"✅ Distribution analysis data prepared:\")\n",
    "print(f\"   • Total volume: {total_volume:.0f} transactions\")\n",
    "print(f\"   • Total titles: {total_titles}\")\n",
    "print(f\"   • 80% volume requires: {pct_titles_for_80:.1f}% of titles ({titles_needed_80} titles)\")\n",
    "print(f\"   • Top 1% threshold: {top_1_pct_threshold:.0f} transactions\")"
   ]
  },
