   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "import numpy as np\n",
    "\n",
    "print(\"🔍 K-MEANS ELBOW ANALYSIS\")\n",
    "print(\"=\" * 80)\n",
    "print(\"Computing TF-IDF vectors from titles...\")\n",
    "\n",
    "# Prepare data\n",
    "valid_titles = df['Title'].dropna().astype(str).values\n",
    "print(f\"   • Total titles to cluster: {len(valid_titles)}\")\n",
    "\n",
    "# TF-IDF vectorization\n",
    "vectorizer = TfidfVectorizer(max_features=100, stop_words='english', \n",
    "                            ngram_range=(1, 2), min_df=2, max_df=0.9)\n",
    "tfidf_matrix = vectorizer.fit_transform(valid_titles)\n",
    "print(f\"   • TF-IDF matrix shape: {tfidf_matrix.shape}\")\n",
    "\n",
    "# Test different K values\n",
    "print(\"\\nTesting K values (2-10)...\")\n",
    "K_range = range(2, 11)\n",
    "inertias = []\n",
    "silhouette_scores = []\n",
    "\n",
    "for k in K_range:\n",
    "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10, max_iter=300)\n",
    "    kmeans.fit(tfidf_matrix)\n",
    "    inertias.append(kmeans.inertia_)\n",
    "    sil_score = silhouette_score(tfidf_matrix, kmeans.labels_)\n",
    "    silhouette_scores.append(sil_score)\n",
    "    print(f\"   K={k}: Inertia={kmeans.inertia_:.2f}, Silhouette={sil_score:.3f}\")\n",
    "\n",
    "# Select optimal K using elbow method (maximum silhouette score)\n",
    "optimal_k = list(K_range)[np.argmax(silhouette_scores)]\n",
    "print(f\"\\n✅ Optimal K selected: {optimal_k} (Silhouette score: {max(silhouette_scores):.3f})\")\n",
    "\n",
    "# Re-fit with optimal K\n",
    "print(f\"\\nFitting final K-Means model with K={optimal_k}...\")\n",
    "kmeans_final = KMeans(n_clusters=optimal_k, random_state=42, n_init=10, max_iter=300)\n",
    "clusters = kmeans_final.fit_predict(tfidf_matrix)\n",
    "\n",
    "# Add cluster assignments to dataframe\n",
    "df['cluster'] = -1\n",
    "df.loc[df['Title'].notna(), 'cluster'] = clusters\n",
    "\n",
    "# Extract top terms for each cluster\n",
    "feature_names = np.array(vectorizer.get_feature_names_out())\n",
    "cluster_info = {}\n",
    "\n",
    "for cluster_id in range(optimal_k):\n",
    "    # Get top terms for this cluster\n",
    "    center = kmeans_final.cluster_centers_[cluster_id]\n",
    "    top_indices = center.argsort()[-5:][::-1]\n",
    "    top_words = [feature_names[i] for i in top_indices]\n",
    "    \n",
    "    # Get cluster statistics\n",
    "    cluster_mask = df['cluster'] == cluster_id\n",
    "    cluster_titles = df[cluster_mask]\n",
    "    count = len(cluster_titles)\n",
    "    total_trans = cluster_titles['Number'].sum()\n",
    "    avg_trans = cluster_titles['Number'].mean() if count > 0 else 0\n",
    "    \n",
    "    cluster_info[cluster_id] = {\n",
    "        'top_words': top_words,\n",
    "        'count': count,\n",
    "        'total_trans': total_trans,\n",
    "        'avg_trans': avg_trans\n",
    "    }\n",
    "    \n",
    "    print(f\"   Cluster {cluster_id}: {count} titles | Avg: {avg_trans:.2f} | Words: {', '.join(top_words)}\")\n",
    "\n",
    "print(\"\\n✅ K-Means clustering complete! Variables ready: optimal_k, cluster_info, K_range, inertias, silhouette_scores\")"
   ]
  },
