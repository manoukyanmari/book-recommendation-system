    "from sklearn.feature_extraction.text import CountVectorizer\n",
    "from collections import Counter\n",
    "import re\n",
    "\n",
    "# LOAD ARMENIAN STOPWORDS FROM CSV FILE\n",
    "import os\n",
    "notebook_dir = os.path.dirname(os.path.abspath('company_a_visualization.ipynb'))\n",
    "stopwords_path = os.path.join(os.path.dirname(notebook_dir), 'armenian_stopwords.csv')\n",
    "\n",
    "# If path doesn't exist, try relative path from current directory\n",
    "if not os.path.exists(stopwords_path):\n",
    "    stopwords_path = 'armenian_stopwords.csv'\n",
    "\n",
    "if os.path.exists(stopwords_path):\n",
    "    import pandas as pd_temp\n",
    "    armenian_stopwords_df = pd_temp.read_csv(stopwords_path)\n",
    "    armenian_stopwords = set(armenian_stopwords_df['word'].str.lower().unique())\n",
    "    print(f\"✅ Loaded {len(armenian_stopwords)} Armenian stopwords from CSV\")\n",
    "else:\n",
    "    # Fallback: hard-coded Armenian stopwords\n",
    "    armenian_stopwords = {\n",
    "        'այդ', 'այն', 'այս', 'եմ', 'են', 'ենք', 'եք', 'է', 'էի', 'էին',\n",
    "        'էինք', 'էիր', 'էիք', 'էր', 'թ', 'ի', 'ին', 'իսկ', 'ն', 'նաև',\n",
    "        'որ', 'որը', 'որոնք', 'ու', 'պիտի', 'և'\n",
    "    ]\n",
    "    print(f\"✅ Using fallback Armenian stopwords ({len(armenian_stopwords)} words)\")\n",
    "\n",
    "# Clean titles for tokenization (lowercase, remove special characters)\n",
    "df['title_clean'] = df['Title'].str.lower().str.replace(r'[^\\w\\s]', ' ', regex=True)\n",
    "\n",
    "# Remove NaN values\n",
    "df_clean = df.dropna(subset=['title_clean'])\n",
    "df_clean = df_clean[df_clean['title_clean'].str.strip() != ''].copy()\n",
    "\n",
    "print(f\"Processing {len(df_clean)} books with titles for N-gram analysis\")\n",
    "\n",
    "# Extract Unigrams (individual words)\n",
    "vectorizer_unigram = CountVectorizer(analyzer='word', ngram_range=(1, 1), \n",
    "                                      stop_words=armenian_stopwords, min_df=2, max_features=100)\n",
    "unigram_matrix = vectorizer_unigram.fit_transform(df_clean['title_clean'])\n",
    "unigram_names = vectorizer_unigram.get_feature_names_out()"
   ]
