   "source": [
    "# Company A Library Genre Analysis & Visualization\n",
    "\n",
    "Comprehensive analysis and visualization of the Company A library collection, including genre distribution, language breakdown, and sales volume patterns."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cf5e61e3",
   "metadata": {},
   "source": [
    "## Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "5581ed81",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ All libraries imported\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "from collections import Counter\n",
    "\n",
    "# Set style\n",
    "sns.set_style(\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "plt.rcParams['font.size'] = 10\n",
    "\n",
    "# Helper function to set smart Y-axis limits based on percentiles\n",
    "def set_smart_ylim(ax, data_list, percentile_lower=1, percentile_upper=99):\n",
    "    \"\"\"Set y-axis limits based on data percentiles to avoid outlier compression\"\"\"\n",
    "    # Filter out empty arrays and flatten non-empty data, removing NaNs\n",
    "    flattened_data = []\n",
    "    for d in data_list:\n",
    "        arr = np.asarray(d).flatten()\n",
    "        if len(arr) > 0:\n",
    "            # Remove NaN values from this array\n",
    "            valid_vals = arr[~np.isnan(arr)]\n",
    "            if len(valid_vals) > 0:\n",
    "                flattened_data.extend(valid_vals)\n",
    "    \n",
    "    # If no valid data, use default limits\n",
    "    if len(flattened_data) == 0:\n",
    "        return\n",
    "    \n",
    "    all_data = np.array(flattened_data)\n",
    "    y_min = np.percentile(all_data, percentile_lower)\n",
    "    y_max = np.percentile(all_data, percentile_upper)\n",
    "    \n",
    "    # Handle case where percentiles might return NaN (shouldn't happen now but as safety)\n",
    "    if not (np.isfinite(y_min) and np.isfinite(y_max)):\n",
    "        return\n",
    "    \n",
    "    y_range = y_max - y_min\n",
    "    padding = y_range * 0.05 if y_range > 0 else 0.5  # Use fixed padding if range is 0\n",
    "    ax.set_ylim(y_min - padding, y_max + padding)\n",
    "\n",
    "print(\"✅ All libraries imported\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "19e5212f",
   "metadata": {},
   "source": [
    "## Load Data"
   ]
  },
