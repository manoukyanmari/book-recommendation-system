    "    for i, (bar, freq) in enumerate(zip(bars1, frequencies)):\n",
    "        width = bar.get_width()\n",
    "        ax1.text(width + 0.05, bar.get_y() + bar.get_height()/2.,\n",
    "                f'{freq:.0f} books', ha='left', va='center', fontweight='bold', fontsize=9)\n",
