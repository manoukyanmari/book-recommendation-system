    "# Create genre distribution bar chart\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "genres = list(dict(genre_counts.most_common()).keys())\n",
    "counts = [genre_counts[g] for g in genres]\n",
    "\n",
