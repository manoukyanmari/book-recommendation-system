      "Adjective                         77.0           1.05           73   \n",
      "Adverb                             7.0           1.00            7   \n",
      "Preposition                       11.0           1.00           11   \n",
      "Pronoun                            7.0           1.00            7   \n",
      "\n",
      "                       Unique_Words  \n",
      "starting_pos_category                \n",
